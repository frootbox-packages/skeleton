# Every request that is not an existing file goes to index.php.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # PHP as FastCGI does not see the header Authorization without this,
    # then the REST API and the hub get no access token.
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

Options -Indexes

# SVG files, e.g. copies from the media library: nothing in them may run
# when opened directly (decision 0182). Other web servers need the same rule.
<IfModule mod_headers.c>
    <FilesMatch "\.svg$">
        Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; sandbox"
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>

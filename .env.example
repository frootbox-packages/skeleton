# Copy this file to .env and adjust it. Never commit .env.
#
# APP_ENV
#   dev   no caches, changes show up immediately, detailed error pages
#   prod  live operation, everything is cached
APP_ENV=prod

# DATABASE_URL
#   SQLite needs no setup. The file lives in storage/ (relative to this folder).
#   For MySQL or MariaDB use e.g.
#   DATABASE_URL=pdo-mysql://user:secret@localhost:3306/frootbox
DATABASE_URL=pdo-sqlite:///storage/database.sqlite

# APP_SECRET
#   A long random value that signs addresses such as those of image sizes.
#   install writes one. Changing it gives every image a new address.
APP_SECRET=

# MAILER_DSN
#   Optional. Without it, mails go out over the SMTP server set in the
#   backend (Settings, Email) or with mail() of PHP; in dev to the log.
#   It goes before the backend, e.g.
#   MAILER_DSN=smtp://user:secret@smtp.example.org:587

# STORAGE_DSN and PUBLIC_STORAGE_DSN
#   Optional, with the module frootbox/storage-s3. Without them, files
#   lie in storage/ and public/. With them, originals and files from
#   forms go into a private bucket, sizes of public images into a public
#   one, delivered from there. Two buckets, key and secret URL-encoded:
#   STORAGE_DSN="s3://key:secret@fsn1.your-objectstorage.com/site-data?region=fsn1"
#   PUBLIC_STORAGE_DSN="s3://key:secret@fsn1.your-objectstorage.com/site-media?region=fsn1&url=https://media.example.org"
#   Then: bin/frootbox storage:push and bin/frootbox storage:check

# Copy this file to .env and adjust it. Never commit .env.
#
# APP_ENV
#   dev   no caches, changes show up immediately, detailed error pages
#   prod  live operation, everything is cached
APP_ENV=prod

# DATABASE_URL
#   SQLite needs no setup. The file lives in storage/ (relative to this folder).
#   For MySQL or MariaDB use e.g.
#   DATABASE_URL=pdo-mysql://user:secret@localhost:3306/frootbox
DATABASE_URL=pdo-sqlite:///storage/database.sqlite

# APP_SECRET
#   A long random value that signs addresses such as those of image sizes.
#   install writes one. Changing it gives every image a new address.
APP_SECRET=
